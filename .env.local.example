# Credenciales de la app de MercadoLibre para Panelux (developers.mercadolibre.com.uy).
# Tiene que ser una app DISTINTA a la de todogastro-bot: misma cuenta
# vendedora, pero cada app registra su propia Redirect URI y obtiene su
# propio access_token/refresh_token al autorizarla.
# TODO: crear app en https://developers.mercadolibre.com.uy/ y cargar credenciales
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_CLIENT_SECRET=
# Debe coincidir EXACTO con la Redirect URI registrada en el panel de la app.
# En desarrollo local: http://localhost:3000/api/auth/mercadolibre/callback
MERCADOLIBRE_REDIRECT_URI=http://localhost:3000/api/auth/mercadolibre/callback

# Upstash Redis (guarda el token de MercadoLibre; Vercel no tiene disco
# persistente entre invocaciones). Crear una base gratuita en
# https://console.upstash.com/ y copiar las credenciales REST de ahi, o
# instalar la integracion "Upstash" desde el marketplace de Vercel.
# En desarrollo local puede quedar vacio (la app falla si no encuentra el
# token, pero sin intentar conectarse a ML no hay problema).
# TODO: en Vercel, instalar la integracion Upstash o crear base manual
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
